# LLM providers
GROQ_API_KEY=
MISTRALAI_API_KEY=

# CORS — browser-facing origin of the frontend
FRONTEND_ORIGIN=http://localhost:3000

# Chat history (async) and dense/pgvector retrieval (sync) -- both derived
# from the same Postgres instance; sync_database_url is auto-derived from
# this in app/core/config.py, no separate var needed.
DATABASE_URL=postgresql+asyncpg://iso15189:iso15189@localhost:5432/iso15189

# S3 bucket holding the BM25 sparse-retrieval corpus and uploaded source
# documents; SQS queue the admin upload endpoint queues background
# ingestion jobs to, consumed by the separate ingestion worker Lambda
# (app/worker/ingest_handler.py).
S3_BUCKET=
AWS_REGION=us-east-1
SQS_QUEUE_URL=
# Local/dev credentials for the resources above -- not needed if the
# backend already has AWS credentials via its environment (e.g. an IAM
# role when actually running on Lambda).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Shared secret for the admin ingestion endpoint
ADMIN_API_KEY=

# Rate-limit storage -- Redis-backed so limits are shared across
# concurrent Lambda invocations rather than per-container.
REDIS_URL=redis://localhost:6379

# Only set to true if the backend sits behind a reverse proxy you control
# that itself sets X-Forwarded-For/X-Real-IP -- otherwise leave unset,
# since a client can spoof these headers to dodge rate limiting.
TRUSTED_PROXY=false

# Frontend — must be a browser-reachable URL, not a docker-internal hostname
NEXT_PUBLIC_API_URL=http://localhost:8000
