# Direct production dependencies of the API and ingestion worker images.
# requirements.txt is generated from this file -- edit here, then recompile:
#
#   uv pip compile requirements.in -o requirements.txt \
#     --python-version 3.11 --python-platform x86_64-manylinux_2_28 \
#     --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match
#
# Dev/test/eval tooling lives in requirements-dev.txt, never here.
--extra-index-url https://download.pytorch.org/whl/cpu

