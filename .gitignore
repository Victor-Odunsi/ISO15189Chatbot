# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Logs
*.log

# Source documents are typically licensed/copyrighted (e.g. the ISO
# 15189 standard itself) -- never commit them, keep the folder tracked
data/*
!data/.gitkeep
!data/README.md

# Env
.env
.env.local

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# AWS SAM build artifacts / local deploy config
.aws-sam/
samconfig.toml

# Synthetic eval dataset -- generated from whatever is currently ingested
# (itself derived from the uncommitted source PDFs above), so it is
# environment-specific rather than a fixture to check in. Regenerate with
# `python -m evals.dataset`.
backend/evals/dataset.jsonl

# Personal Claude Code permission overrides (not shared project config)
.claude/settings.local.json

# OS
.DS_Store
